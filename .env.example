# Google tag. Set either or both, then rebuild. Nothing is injected if unset.
# GA4 measurement id, looks like G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Google Tag Manager container id, looks like GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=
# Search Console verification token, the value of the google-site-verification meta tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
